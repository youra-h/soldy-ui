{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "noEmit": true,
    "paths": {
      "@soxa-ui/theme-oren/setup": ["../../packages/themes/oren/setup/index.ts"],
      "@soxa-ui/theme-base/setup": ["../../packages/themes/base/setup/index.ts"],
      "@soxa-ui/core": ["../../packages/core/src"],
      "@soxa-ui/icons-material": ["../../packages/icons/material/src"],
      "@soxa-ui/plugins": ["../../packages/plugins/src"],
      "@soxa-ui/setup": ["../../packages/setup/index.ts"],
      "@soxa-ui/playground-shared": ["../../packages/playground/shared/src/index.ts"]
    }
  },
  // The framework entries draw the hosts' previews, which are type programs of
  // the developer stand (each with its own JSX and Angular options); the run's
  // own code is the measurement and the page contract
  "include": ["src/page.ts", "src/measure.ts"]
}
