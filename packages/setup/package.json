{
  "name": "@soxa-ui/setup",
  "version": "0.4.0",
  "description": "Общее для всех адаптеров: дескрипторы компонентов, их сборка на монтирование и связывание с фреймворком",
  "keywords": [
    "soxa",
    "headless",
    "ui",
    "descriptors"
  ],
  "license": "MIT",
  "author": "Yuri Soldatov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/youra-h/soxa-ui.git",
    "directory": "packages/setup"
  },
  "homepage": "https://github.com/youra-h/soxa-ui",
  "bugs": {
    "url": "https://github.com/youra-h/soxa-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./api.json": "./dist/api.json"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@soxa-ui/core": "0.4.0",
    "@soxa-ui/plugins": "0.4.0"
  },
  "scripts": {
    "build": "vite build -c vite.lib.config.ts && tsc -p tsconfig.build.json && tsx --tsconfig tsconfig.json ../../tools/api-docs/cli.ts --package",
    "test": "vitest run"
  }
}
