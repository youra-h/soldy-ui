{
  "name": "@soxa-ui/theme-base",
  "version": "0.3.0-beta.1",
  "description": "Общий слой тем Soxa UI: сброс частей библиотеки, знак направления письма и структура частей с числами в переменных — чистый CSS, без препроцессора, — и плагины раскладки для поведения темы",
  "keywords": [
    "soxa",
    "ui",
    "theme",
    "css"
  ],
  "license": "MIT",
  "author": "Yuri Soldatov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/youra-h/soxa-ui.git",
    "directory": "packages/themes/base"
  },
  "homepage": "https://github.com/youra-h/soxa-ui",
  "bugs": {
    "url": "https://github.com/youra-h/soxa-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "style": "./src/index.css",
  "exports": {
    ".": "./src/index.css",
    "./setup": {
      "types": "./dist/setup/index.d.ts",
      "default": "./dist/setup/index.js"
    },
    "./theme-variables.json": "./theme-variables.json",
    "./theme-contract.json": "./theme-contract.json"
  },
  "files": [
    "dist",
    "src",
    "theme-variables.json",
    "theme-contract.json"
  ],
  "scripts": {
    "build": "vite build -c vite.setup.config.ts && tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@soxa-ui/core": "^0.3.0-beta.1",
    "@soxa-ui/plugins": "^0.3.0-beta.1"
  },
  "devDependencies": {
    "postcss": "^8.5.9",
    "postcss-selector-parser": "^7.1.6"
  }
}
