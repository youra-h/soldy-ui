{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // Нативный загрузчик конфигов Vite требует расширение в импортах фабрики
    // сборки (`../../../tools/vite/lib.config.ts`) и шага Tailwind
    // (`./tailwind-postcss.ts`), TypeScript без этого флага их запрещает.
    // Безопасно: пакет эмитит только декларации поведения, а его исходники
    // импортируют друг друга без расширений.
    "allowImportingTsExtensions": true,
    "paths": {
      "@soxa-ui/core": ["../../core/src"],
      "@soxa-ui/plugins": ["../../plugins/src"],
      "@soxa-ui/setup": ["../../setup/index.ts"],
      "@soxa-ui/theme-base/setup": ["../base/setup/index.ts"],
      "@soxa-ui/theme-oren": ["./index.d.ts"],
      "@soxa-ui/theme-oren/setup": ["./setup/index.ts"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
