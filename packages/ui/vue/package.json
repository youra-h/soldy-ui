    "@soxa-ui/setup": "0.4.0"
  },
  "peerDependencies": {
    "vue": "^3.5.21"
  },
  "devDependencies": {
    "@soxa-ui/icons-material": "0.3.1",
    "@types/node": "^26.1.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue": "^3.5.32",
