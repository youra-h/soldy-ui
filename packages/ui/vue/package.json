{
  "name": "@soxa-ui/vue",
  "version": "0.4.0",
  "description": "Адаптер Vue: компоненты на headless-моделях ядра",
  "keywords": [
    "soxa",
    "headless",
    "ui",
    "components",
    "vue"
  ],
  "license": "MIT",
  "author": "Yuri Soldatov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/youra-h/soxa-ui.git",
    "directory": "packages/ui/vue"
  },
  "homepage": "https://github.com/youra-h/soxa-ui",
  "bugs": {
    "url": "https://github.com/youra-h/soxa-ui/issues"
  },
