{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@soxa-ui/core": ["../../core/src"],
      "@soxa-ui/core/*": ["../../core/src/*"],
      "@soxa-ui/icons-material": ["../../icons/material/src"],
      "@soxa-ui/plugins": ["../../plugins/src"],
      "@soxa-ui/plugins/*": ["../../plugins/src/*"],
      "@soxa-ui/react": ["./src/index.ts"],
      "@soxa-ui/setup": ["../../setup/index.ts"],
      "@soxa-ui/setup/*": ["../../setup/*"]
    }
  },
  "include": ["env.d.ts", "src/**/*", "__tests__/**/*"]
}
