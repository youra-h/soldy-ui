{
  // Хост Solid — своя программа типов: оболочка стенда — Vue, и `.tsx` с JSX
  // Solid в программе vue-tsc ей не место (её `tsconfig.json` хост исключает).
  // JSX у Solid свой: Vite его не трогает (`preserve`), собирает плагин Solid.
  // Соседей хост, как и оболочка, читает исходниками.
  "extends": "../../../../../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "noEmit": true,
    "types": [],
    "paths": {
      "@soxa-ui/core": ["../../../../../core/src"],
      "@soxa-ui/plugins": ["../../../../../plugins/src"],
      "@soxa-ui/setup": ["../../../../../setup/index.ts"],
      "@soxa-ui/solid": ["../../../../../ui/solid/src/index.ts"],
      "@soxa-ui/playground-shared": ["../../../../shared/src/index.ts"]
    }
  },
  "include": ["./**/*"]
}
