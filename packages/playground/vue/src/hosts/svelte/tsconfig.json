{
  // Хост Svelte — своя программа типов: оболочка стенда — Vue, и `.svelte`
  // в программе vue-tsc ей не место (её `tsconfig.json` хост исключает).
  // Проверяет её svelte-check. Соседей хост, как и оболочка, читает
  // исходниками.
  "extends": "../../../../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [],
    "paths": {
      "@soxa-ui/core": ["../../../../../core/src"],
      "@soxa-ui/plugins": ["../../../../../plugins/src"],
      "@soxa-ui/setup": ["../../../../../setup/index.ts"],
      "@soxa-ui/svelte": ["../../../../../ui/svelte/src/index.ts"],
      "@soxa-ui/playground-shared": ["../../../../shared/src/index.ts"]
    }
  },
  "include": ["./**/*"]
}
