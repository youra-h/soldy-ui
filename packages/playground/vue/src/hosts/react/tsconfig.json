{
  // Хост React — своя программа типов: оболочка стенда — Vue, и `.tsx` с JSX
  // React в программе vue-tsc ей не место (её `tsconfig.json` хост исключает).
  // Соседей хост, как и оболочка, читает исходниками.
  "extends": "../../../../../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noEmit": true,
    "types": [],
    "paths": {
      "@soxa-ui/core": ["../../../../../core/src"],
      "@soxa-ui/plugins": ["../../../../../plugins/src"],
      "@soxa-ui/setup": ["../../../../../setup/index.ts"],
      "@soxa-ui/react": ["../../../../../ui/react/src/index.ts"],
      "@soxa-ui/playground-shared": ["../../../../shared/src/index.ts"]
    }
  },
  "include": ["./**/*"]
}
