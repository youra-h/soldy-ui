{
  // Хост Web Components — своя программа типов, как у остальных хостов:
  // оболочка его не импортирует (её `tsconfig.json` хост исключает), его грузит
  // загрузчик ленивым glob. JSX у хоста нет — элементы строит код. Соседей
  // хост, как и оболочка, читает исходниками.
  "extends": "../../../../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [],
    "paths": {
      "@soxa-ui/core": ["../../../../../core/src"],
      "@soxa-ui/plugins": ["../../../../../plugins/src"],
      "@soxa-ui/setup": ["../../../../../setup/index.ts"],
      "@soxa-ui/webc": ["../../../../../ui/webc/src/index.ts"],
      "@soxa-ui/playground-shared": ["../../../../shared/src/index.ts"]
    }
  },
  "include": ["./**/*"]
}
